# TMDB API Configuration (required for series data)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# MongoDB Configuration (required for watchlist, user, recommendations cache)
# Local: mongodb://localhost:27017/cineverse
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/cineverse?retryWrites=true&w=majority
MONGODB_URI=

# Optional: AI features (Groq). Leave empty for non-AI fallbacks.
GROQ_API_KEY=

# Auth (required for login/signup). Use a long random string in production.
JWT_SECRET=your-jwt-secret-min-32-chars

# Optional: App URL for absolute links (defaults work for Vercel/Render)
NEXT_PUBLIC_APP_URL=http://localhost:3000